rules_version = '2';

// Regole di sicurezza Firestore per MedicinePro.
// Da incollare in: Console Firebase > Firestore Database > Regole > Pubblica.
//
// Ogni utente può leggere e scrivere SOLO il proprio backup:
//   backups/{suo uid}                 -> informazioni sul backup (numero di parti, data)
//   backups/{suo uid}/chunks/{n}      -> le parti del backup (max ~1 MB ciascuna)
// Tutto il resto del database è bloccato.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /backups/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && request.resource.data is map;

      match /chunks/{chunkId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && request.resource.data.data is string;
      }
    }

    // Blocca qualsiasi altra collezione
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
